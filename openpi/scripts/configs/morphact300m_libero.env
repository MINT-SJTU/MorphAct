#!/usr/bin/env bash
# LIBERO-40 Pi0/Pi0.5 recipe; caller supplies weights, data, assets and GPUs.
export LIBERO_DATASET=all
export EXP_NAME=morphact300m-libero-gb64
export NUM_GPUS=4
export PER_GPU_BATCH_SIZE=16
export GRADIENT_ACCUMULATION_STEPS=1
export WARMUP_STEPS=1000
export PEAK_LR=2.5e-5
export DECAY_LR=2.5e-6
export MORPHACT_WIDTH=1024
export VLM_MORPHACT_LAYERS=8
export ACTION_MORPHACT_LAYERS=6
export MORPHACT_COMPUTE_PRECISION=bfloat16
export PRECISION=bfloat16
export GRADIENT_CHECKPOINTING=1
export ADAM_BETA1=0.9
export ADAM_BETA2=0.95
export ADAM_EPS=1e-8
export WEIGHT_DECAY=1e-10
export MAX_GRAD_NORM=1.0
export SAVE_INTERVAL=2500
export LOG_INTERVAL=10
export NUM_WORKERS=8
export LOADER_WORKERS_OVERRIDE=2
export SEED=42
export SAMPLER_SEED=0
export SWANLAB_ENABLED=1
export SWANLAB_MODE=local
export SWANLAB_PROJECT=morphact
